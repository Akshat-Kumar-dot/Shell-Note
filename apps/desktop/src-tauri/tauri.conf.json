{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellNote",
  "version": "0.1.0",
  "identifier": "app.shellnote.desktop",
  "build": {
    "beforeDevCommand": "node run.mjs web-dev",
    "devUrl": "http://localhost:5194",
    "beforeBuildCommand": "node run.mjs web-build",
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http:",
        "frame-src": "https: http:",
        "media-src": "'self' blob:",
        "worker-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
